%% EXTRACT NEEDLE PASSAGE TIMES (PUNCTURE -> CLEAR) THROUGH ENTRY/EXIT HOLES
% Treats the needle as an extended curved body (not just the tip point).
% "Puncture" = first instant ANY part of the needle enters the hole footprint
% "Clear"    = last instant ANY part of the needle is still inside the hole footprint
%              (i.e., just before the whole needle has moved away)

clear; clc; close all;

%% --- Needle geometry parameters ---
NEEDLE_RADIUS    = 0.01018;     % m (10.18 mm)
NEEDLE_ARC_DEG   = 120;         % degrees
ARC_SIGN         = -1;          % +1 or -1: VALIDATE visually, flip if tail is on wrong side
N_SAMPLE_PTS     = 60;          % points sampled along the needle body (tip -> tail)
tip_offset_local = [0.00661780871450901, 0.0069734565913677216, 0.0];  % validated tip offset (m)

TOL_LATERAL = 0.0035;   % m, in-plane tolerance defining hole footprint (matches your existing tol_hit)
TOL_DEPTH   = 0.0025;   % m, out-of-plane "thickness" band around the hole plane - TUNE to your model

NUM_SCENARIOS = 6;
NUM_TRIALS    = 10;
NUM_SUTURES   = 4;
NUM_STATES    = 2;   % 1 = puncture (entry-in / exit-in), 2 = clear (entry-out / exit-out)

base_path = '/home/acatalano/Desktop/Intuitive/BehavioraldVRKData/IE_SaveData';

%% --- Build local-frame needle sample points (tip -> tail along the arc) ---
theta_tip = atan2(tip_offset_local(2), tip_offset_local(1));
r_eff     = norm(tip_offset_local(1:2));   % effective in-plane radius to the tip point
arc_rad   = deg2rad(NEEDLE_ARC_DEG);

thetas = linspace(theta_tip, theta_tip + ARC_SIGN*arc_rad, N_SAMPLE_PTS);
needle_pts_local = [r_eff*cos(thetas') , r_eff*sin(thetas'), zeros(N_SAMPLE_PTS,1)];
% needle_pts_local(1,:)   == tip
% needle_pts_local(end,:) == tail

sc = load_scenario_coordinates();
subjects  = {'IE01','IE02','IE03','IE04','IE05','IE07','IE08','IE09','IE10','IE11'};
NUM_SUBJECTS = length(subjects);

EntryPunctureMatrix = nan(NUM_SUBJECTS, NUM_SCENARIOS, NUM_TRIALS, NUM_SUTURES);
EntryClearMatrix    = nan(NUM_SUBJECTS, NUM_SCENARIOS, NUM_TRIALS, NUM_SUTURES);
ExitPunctureMatrix  = nan(NUM_SUBJECTS, NUM_SCENARIOS, NUM_TRIALS, NUM_SUTURES);
ExitClearMatrix     = nan(NUM_SUBJECTS, NUM_SCENARIOS, NUM_TRIALS, NUM_SUTURES);

fprintf('Inizio elaborazione cinematica (needle-as-body) da:\n%s\n\n', base_path);

for s = 1:NUM_SUBJECTS
    subj_name = subjects{s};
    subj_path = fullfile(base_path, [subj_name '_SaveData']);

    trial_dirs = dir(fullfile(subj_path, '*scenario*'));   % discover, don't construct
    trial_dirs = trial_dirs([trial_dirs.isdir]);
    
    for t = 1:length(trial_dirs)
        folder_name = trial_dirs(t).name;
        tokens = regexp(folder_name, '<PATTERN MATCHING YOUR ACTUAL FOLDERS>', 'tokens');
        if isempty(tokens), continue; end
        scenario_num = str2double(tokens{1}{2});
        data_csv   = readmatrix(csv_file);
        valid_idx  = all(~isnan(data_csv(:, 2:8)), 2);
        data_clean = data_csv(valid_idx, :);
        if isempty(data_clean), continue; end

        time_vec    = data_clean(:,1) - data_clean(1,1);
        pos_Origin  = data_clean(:,2:4);
        quat_Needle = data_clean(:,5:8);
        nSamples    = size(pos_Origin,1);

        % Precompute world-frame positions of ALL sampled needle points, ALL timesteps
        needle_world = zeros(nSamples, N_SAMPLE_PTS, 3);
        for k = 1:nSamples
            R = quat2rotm_ros(quat_Needle(k,:));
            needle_world(k,:,:) = (R * needle_pts_local')' + pos_Origin(k,:);
        end

        for i = 1:size(sc(scenario_num).en,1)
            [t_punct_en, t_clear_en] = find_needle_passage(sc(scenario_num).en(i,:), sc(scenario_num).en_q(i,:), ...
                needle_world, time_vec, TOL_LATERAL, TOL_DEPTH);

            [t_punct_ex, t_clear_ex] = find_needle_passage(sc(scenario_num).ex(i,:), sc(scenario_num).ex_q(i,:), ...
                needle_world, time_vec, TOL_LATERAL, TOL_DEPTH);

            EntryPunctureMatrix(s, scenario_num, trial_num, i) = t_punct_en;
            EntryClearMatrix(s, scenario_num, trial_num, i)    = t_clear_en;
            ExitPunctureMatrix(s, scenario_num, trial_num, i)  = t_punct_ex;
            ExitClearMatrix(s, scenario_num, trial_num, i)     = t_clear_ex;
        end

        fprintf('Soggetto %s | Scenario %d | Trial %d : Passage times calcolati.\n', subj_name, scenario_num, trial_num);
    end
end

save('NeedlePassageTimes_IR.mat', 'EntryPunctureMatrix', 'EntryClearMatrix', 'ExitPunctureMatrix', 'ExitClearMatrix');
fprintf('\n=== COMPLETATO === Matrici salvate in NeedlePassageTimes_IR.mat\n');

%%  FUNCTIONS 

function [t_puncture, t_clear] = find_needle_passage(hole_pos, hole_quat, needle_world, time_vec, tol_lateral, tol_depth)
    % Returns puncture (first entry) and clear (last exit) time of the FULL
    % needle body through a single hole's footprint.
    R = quat2rotm_ros(hole_quat);
    U = R(:,1)';   % in-plane axis 1
    V = R(:,2)';   % in-plane axis 2
    N = R(:,3)';   % plane normal

    nSamples = size(needle_world,1);
    in_hole  = false(nSamples,1);

    for k = 1:nSamples
        pts    = squeeze(needle_world(k,:,:));   % N_SAMPLE_PTS x 3
        V_diff = pts - hole_pos;

        dz = V_diff * N';
        dx = V_diff * U';
        dy = V_diff * V';

        inside     = (abs(dz) <= tol_depth) & (abs(dx) <= tol_lateral) & (abs(dy) <= tol_lateral);
        in_hole(k) = any(inside);
    end

    t_puncture = NaN;
    t_clear    = NaN;

    idx_in = find(in_hole);
    if isempty(idx_in), return; end

    idx_first = idx_in(1);
    idx_last  = idx_in(end);

    if idx_first > 1
        t_puncture = interp_boundary_time(time_vec, in_hole, idx_first-1, idx_first);
    else
        t_puncture = time_vec(idx_first);
    end

    if idx_last < nSamples
        t_clear = interp_boundary_time(time_vec, in_hole, idx_last, idx_last+1);
    else
        t_clear = time_vec(idx_last);
    end
end

function t_interp = interp_boundary_time(time_vec, in_hole, idx_a, idx_b)
    a = double(in_hole(idx_a));
    b = double(in_hole(idx_b));
    if a == b
        t_interp = time_vec(idx_b);
        return;
    end
    frac = max(0, min(1, (0.5 - a) / (b - a)));
    t_interp = time_vec(idx_a) + frac * (time_vec(idx_b) - time_vec(idx_a));
end

function R = quat2rotm_ros(q)
    qx = q(1); qy = q(2); qz = q(3); qw = q(4);
    R = [1 - 2*qy^2 - 2*qz^2,  2*qx*qy - 2*qz*qw,      2*qx*qz + 2*qy*qw;
         2*qx*qy + 2*qz*qw,      1 - 2*qx^2 - 2*qz^2,  2*qy*qz - 2*qx*qw;
         2*qx*qz - 2*qy*qw,      2*qy*qz + 2*qx*qw,      1 - 2*qx^2 - 2*qy^2];
end

